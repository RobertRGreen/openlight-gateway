{
  "name": "openlight-gateway",
  "version": "0.1.0",
  "description": "A standalone, local-first, brand-agnostic smart-lighting gateway/API.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "dist/service/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/service/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/service/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "bonjour-service": "^1.2.1",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
