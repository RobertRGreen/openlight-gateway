# Example values only; leave credentials empty until configured locally.
PORT=3000
# BIND_MODE accepts localhost|lan. LAN requires TLS_MODE=gateway|proxy.
BIND_MODE=localhost
TLS_MODE=disabled
TLS_CERT_PATH=
TLS_KEY_PATH=
TRUSTED_PROXIES=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_PATH=./data/openlight.sqlite
GATEWAY_NAME=OpenLight Gateway
MDNS_ENABLED=false
CORS_ORIGINS=
LOG_LEVEL=info
MOCK_LATENCY_MS=5
ADAPTER_TIMEOUT_MS=5000
API_TOKEN_SALT=
# Opt in only after enabling each device's LAN Control in the Govee Home app.
GOVEE_ADAPTER_ENABLED=false
GOVEE_DISCOVERY_TIMEOUT_MS=1500
# Cloud is a separate adapter and requires a Govee Developer API key.
GOVEE_CLOUD_ADAPTER_ENABLED=false
GOVEE_API_KEY=
# Feit/Tuya local TCP control only; no cloud calls or network discovery.
# Writes are confirmed by querying device DPS after CONTROL, not by a CONTROL acknowledgement.
# Extract credentials once with tinytuya wizard outside this repository.
# IMPORTANT: wrap FEIT_DEVICES in single quotes in this file. A device's local key is
# a random 16-byte string and can contain a literal '#' -- Node's --env-file parser treats
# an UNQUOTED '#' as a comment start and silently truncates the rest of the line, which
# breaks the JSON. Single-quoting (not double-quoting, since the JSON itself uses double
# quotes) avoids this. Example: FEIT_DEVICES='[{"id":...}]'
FEIT_ADAPTER_ENABLED=false
FEIT_DEVICES=[]
# FEIT_DEVICES is a JSON array. Example shape (placeholders only):
# [{"id":"<device-id>","name":"<display-name>","ip":"<device-ip>","localKey":"<16-byte-local-key>","version":"3.5","dpsMap":{"power":"20","workMode":"21","brightness":{"id":"22","minimum":10,"maximum":1000,"step":1},"colour":"24"}}]
# version must be "3.3", "3.4", or "3.5" -- get the real value from tinytuya wizard's output, don't guess. dpsMap and its fields are optional.
# power/workMode/colour are DP ID strings. Set colour:null to disable RGB.
# brightness accepts partial overrides of id/minimum/maximum/step shown above.
# Gateway brightness 0-100 maps linearly to raw minimum-maximum, rounded to raw step.
# Brightness 0 selects raw minimum; it does not implicitly switch power off.
# Color temperature is disabled by default. Optional dpsMap.colorTemperature:
# {id?:string,rawMinimum:number,rawMaximum:number,minimumKelvin:number,maximumKelvin:number,step?:number}
# Supply BOTH raw device endpoints AND user-calibrated Kelvin endpoints to enable it.
# id defaults to "23"; step is a raw-device increment (default 1).
# Conversion is an approximate linear calibration; confirm on live hardware.
# Set colorTemperature:null to disable. No Kelvin endpoints are assumed.
# colour uses 12-character HSV hex encoding; confirm against real device responses.
