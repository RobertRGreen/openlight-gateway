# Example values only; leave credentials empty until configured locally.
PORT=3000
# BIND_MODE accepts localhost|lan. LAN requires TLS_MODE=gateway|proxy.
BIND_MODE=localhost
TLS_MODE=disabled
TLS_CERT_PATH=
TLS_KEY_PATH=
TRUSTED_PROXIES=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_PATH=./data/openlight.sqlite
GATEWAY_NAME=OpenLight Gateway
MDNS_ENABLED=false
CORS_ORIGINS=
LOG_LEVEL=info
MOCK_LATENCY_MS=5
ADAPTER_TIMEOUT_MS=5000
API_TOKEN_SALT=
# Opt in only after enabling each device's LAN Control in the Govee Home app.
GOVEE_ADAPTER_ENABLED=false
GOVEE_DISCOVERY_TIMEOUT_MS=1500
# Cloud is a separate adapter and requires a Govee Developer API key.
GOVEE_CLOUD_ADAPTER_ENABLED=false
GOVEE_API_KEY=
